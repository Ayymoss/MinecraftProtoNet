@page "/"
@inject BotService Bot
@inject IAccountManager AccountManager
@using Bot.Webcore.Services
@using MinecraftProtoNet.Core.Auth.Managers
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>MinecraftProtoNet - Dashboard</PageTitle>

<div class="text-slate-200">
    <!-- Top Navigation / Status Header -->
    <header class="bg-slate-900/60 backdrop-blur-md border border-slate-800/70 rounded-md mb-8 shadow-sm overflow-hidden">
        <div class="px-6 py-4 flex flex-col xl:flex-row items-center justify-between gap-6">

            <!-- Branding & Status Info -->
            <div class="flex items-center gap-4 w-full xl:w-auto">
                <div class="p-2.5 bg-emerald-500/10 rounded border border-emerald-500/25">
                    <i class="ph-duotone ph-cube text-2xl text-emerald-400"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-100">
                        MinecraftProtoNet
                    </h1>
                    
                    <div class="flex flex-wrap items-center gap-3 text-sm mt-2 font-medium">
                        <!-- Connection Status -->
                        <span class="flex items-center gap-2 @(Bot.IsConnected ? "text-emerald-400" : "text-slate-500")">
                            <span class="relative flex h-2.5 w-2.5">
                                @if (Bot.IsConnected) {
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                                } else {
                                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                                }
                            </span>
                            @(Bot.IsConnected ? "Connected" : "Offline")
                        </span>
                        
                        @if (Bot.IsConnected) {
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                            <span class="text-slate-400 flex items-center gap-1.5 hover:text-slate-300 transition-colors">
                                <i class="ph-duotone ph-map-pin text-emerald-500 text-base"></i>
                                @FormatPosition()
                            </span>
                        }
                        @if (Bot.IsAuthenticated) {
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="ph-duotone ph-shield-check text-emerald-500 text-base"></i>
                                Authenticated
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Connection Form & Actions -->
            <div class="flex items-center gap-1.5 bg-slate-950/60 p-1.5 rounded border border-slate-800/70 w-full xl:w-auto overflow-x-auto">
                <div class="flex items-center gap-2 px-3 min-w-[260px]">
                    <i class="ph-duotone ph-globe-hemisphere-west text-slate-500 text-base"></i>
                    <input type="text" @bind="Bot.ServerAddress"
                           class="bg-transparent border-none outline-none text-slate-200 w-full placeholder:text-slate-600 focus:ring-0 text-sm"
                           placeholder="Server Address"/>
                    <span class="text-slate-700">:</span>
                    <input type="number" @bind="Bot.ServerPort"
                           class="bg-transparent border-none outline-none text-slate-200 w-20 placeholder:text-slate-600 focus:ring-0 text-sm"
                           placeholder="Port"/>
                </div>

                <div class="w-px h-7 bg-slate-800 shrink-0"></div>

                @if (Bot.IsConnected) {
                    <button @onclick="PanicStop" disabled="@_panicking"
                            title="Emergency stop: halts Bazaar engine and disconnects immediately"
                            class="flex items-center gap-2 px-4 py-2 bg-rose-500/90 hover:bg-rose-500 text-white rounded transition-colors border border-rose-400/60 font-semibold text-sm animate-pulse shrink-0 disabled:opacity-50 disabled:cursor-not-allowed disabled:animate-none">
                        @if (_panicking) {
                            <i class="ph-duotone ph-spinner-gap animate-spin"></i>
                            <span>Stopping</span>
                        } else {
                            <i class="ph-fill ph-warning-octagon"></i>
                            <span>Panic</span>
                        }
                    </button>
                    <button @onclick="Disconnect"
                            class="flex items-center gap-2 px-4 py-2 bg-transparent hover:bg-rose-500/10 text-rose-400 hover:text-rose-300 rounded transition-colors border border-rose-500/25 font-medium text-sm shrink-0">
                        <i class="ph-bold ph-plug-x"></i>
                        Disconnect
                    </button>
                } else {
                    <button @onclick="Connect" disabled="@(_connecting || !_hasActiveAccount)"
                            title="@(_hasActiveAccount ? "Connect to server" : "No active account selected. Go to /accounts to add or select one.")"
                            class="flex items-center gap-2 px-4 py-2 bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 hover:text-emerald-200 rounded transition-colors border border-emerald-500/30 font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed shrink-0">
                        @if (_connecting) {
                            <i class="ph-duotone ph-spinner-gap animate-spin"></i>
                            <span>Connecting</span>
                        } else {
                            <i class="ph-bold ph-plug"></i>
                            <span>Connect</span>
                        }
                    </button>
                }

                <a href="/accounts"
                   title="Manage accounts"
                   class="flex items-center gap-2 px-3 py-2 bg-transparent hover:bg-slate-800/60 text-slate-400 hover:text-slate-200 rounded transition-colors border border-slate-800 text-sm shrink-0">
                    <i class="ph-bold ph-user-list"></i>
                    <span class="hidden md:inline">Accounts</span>
                </a>
            </div>
        </div>

        @if (!_hasActiveAccount && !Bot.IsConnected)
        {
            <div class="px-6 py-2.5 border-t border-slate-800/60 bg-amber-500/5 text-amber-300 text-sm flex items-center gap-3">
                <i class="ph-duotone ph-warning-circle text-lg shrink-0"></i>
                <span>No active Microsoft account.</span>
                <a href="/accounts" class="underline underline-offset-2 hover:text-amber-200 font-semibold">Add or select one</a>
                <span class="text-amber-400/60">before connecting.</span>
            </div>
        }

        @if (Bot.LastPanicReason != null)
        {
            <div class="px-6 py-2.5 border-t border-rose-500/30 bg-rose-500/10 text-rose-200 text-sm flex items-center gap-3">
                <i class="ph-fill ph-warning-octagon text-lg shrink-0 text-rose-400"></i>
                <div class="flex-1 min-w-0">
                    <span class="font-bold text-rose-300">Panic stop:</span>
                    <span class="ml-2 break-words">@Bot.LastPanicReason</span>
                    @if (Bot.LastPanicAt.HasValue)
                    {
                        <span class="ml-2 text-rose-400/60 text-xs tabular-nums">@Bot.LastPanicAt.Value.LocalDateTime.ToString("HH:mm:ss")</span>
                    }
                </div>
                <button @onclick="() => Bot.AcknowledgePanic()" class="shrink-0 p-1 text-rose-400/70 hover:text-rose-200" title="Dismiss">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>
        }

        @if (Bot.State.LastDisconnectReason != null && !Bot.IsConnected)
        {
            <div class="px-6 py-2.5 border-t border-amber-500/30 bg-amber-500/10 text-amber-200 text-sm flex items-center gap-3">
                <i class="ph-duotone ph-plug-x text-lg shrink-0 text-amber-400"></i>
                <div class="flex-1 min-w-0">
                    <span class="font-bold text-amber-300">Disconnected:</span>
                    <span class="ml-2 break-words">@Bot.State.LastDisconnectReason</span>
                    @if (Bot.State.LastDisconnectTranslateKey != null)
                    {
                        <span class="ml-2 text-amber-400/50 text-xs font-mono">(@Bot.State.LastDisconnectTranslateKey)</span>
                    }
                </div>
                <button @onclick="() => Bot.AcknowledgeDisconnect()" class="shrink-0 p-1 text-amber-400/70 hover:text-amber-200" title="Dismiss">
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>
        }
    </header>

    <!-- Main Content Dashboard Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 xl:gap-6 items-start">
        
        <!-- Left Panel: Context (Stats, Chat) -->
        <div class="lg:col-span-4 xl:col-span-3 space-y-5 xl:space-y-6 flex flex-col">
            <PlayerStats/>
            <ChatReview/>
        </div>

        <!-- Center Panel: Primary Interaction (Inventory, Container, Commands) -->
        <div class="lg:col-span-8 xl:col-span-6 space-y-5 xl:space-y-6 flex flex-col">
            <InventoryView/>
            <ContainerView/>
            <SignEditorView/>
            <MovementPanel/>
            <CommandPanel/>
        </div>

        <!-- Right Panel: Environment & Trading -->
        <div class="lg:col-span-12 xl:col-span-3 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-1 gap-6 xl:gap-8 items-start">
            <BazaarDashboard/>
            <PlayerList/>
            <EntityList/>
        </div>
        
    </div>
</div>

@code {
    private bool _connecting;
    private bool _panicking;
    private bool _hasActiveAccount;

    protected override async Task OnInitializedAsync()
    {
        Bot.OnStateChanged += OnBotStateChanged;
        await RefreshActiveAccount();
    }

    private async Task RefreshActiveAccount()
    {
        try
        {
            _hasActiveAccount = await AccountManager.GetActiveAccountIdAsync() != null;
        }
        catch
        {
            _hasActiveAccount = false;
        }
    }

    private void OnBotStateChanged()
    {
        // Marshal to UI thread since events may fire from background threads
        InvokeAsync(async () =>
        {
            await RefreshActiveAccount();
            StateHasChanged();
        });
    }

    private async Task Connect()
    {
        _connecting = true;
        StateHasChanged();

        try
        {
            await Bot.ConnectAsync();
        }
        finally
        {
            _connecting = false;
            StateHasChanged();
        }
    }

    private async Task Disconnect()
    {
        await Bot.DisconnectAsync();
    }

    private async Task PanicStop()
    {
        _panicking = true;
        StateHasChanged();
        try
        {
            await Bot.PanicStopAsync("Manual stop from web UI");
        }
        finally
        {
            _panicking = false;
            StateHasChanged();
        }
    }

    private string FormatPosition()
    {
        var pos = Bot.State.LocalPlayer?.Entity?.Position;
        if (pos == null) return "Unknown";
        return $"{pos.X:F1}, {pos.Y:F1}, {pos.Z:F1}";
    }

    public void Dispose()
    {
        Bot.OnStateChanged -= OnBotStateChanged;
    }
}